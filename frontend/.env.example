# Public build-time settings, never credentials. Exact string 'true' enables a flag.
# Set true for an independent informational landing; no auth, API events, lead collection or billing.
VITE_MARKETING_ONLY=false
# Opt-in form in product mode only. Marketing-only overrides this setting.
# Backend EARLY_ACCESS_ENABLED must also be true before real requests can persist.
VITE_EARLY_ACCESS_ENABLED=false
VITE_API_BASE_URL=
# Supply only real, owner-approved information before public launch.
VITE_LEGAL_NAME=
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
