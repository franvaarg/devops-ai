PORT=3000

DB_HOST=database
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=devops_ai
# Hosted PostgreSQL connection string; when set, this takes precedence over DB_*.
DATABASE_URL=postgresql://username:password@host:5432/database_name

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=your_gemini_api_key

# Comma-separated production frontend origins. Empty preserves local development.
CORS_ORIGINS=http://localhost:5173
# Set to the number of trusted reverse proxies in front of Express.
TRUST_PROXY_HOPS=

FRONTEND_URL=http://localhost:5173
EMAIL_FROM=KANYI <no-reply@example.com>
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional model override; verify availability in your Google project before release.
GEMINI_MODEL=gemini-3.6-flash
# DATABASE_URL always requires verified TLS. Use DB_* for local non-TLS development.

# Integration tests never use DATABASE_URL or these production credentials.
# Optional path to local PostgreSQL server binaries for npm run test:integration:
# PG_TEST_BIN=/usr/lib/postgresql/16/bin

# Enable sales only after completing docs/COMMERCIAL_RELEASE.md live billing gates.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
